    "path": "/auth/register",
    "access": "Public",
    "contract": "email,password,name,accountType=CREATOR/BRAND/AGENCY \u2192 user, memberships",
    "guard": "No public OWNER assignment; email uniqueness; create requested profile/org transactionally."
  },
  {
    "id": "API-002",
