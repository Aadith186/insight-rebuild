MONGODB_URI=mongodb://127.0.0.1:27017/insight?replicaSet=rs0&directConnection=true
APP_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads
TRUST_PROXY=0
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
BOOTSTRAP_OWNER_EMAIL=owner@insight.local
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password
SEED_DEMO=false
