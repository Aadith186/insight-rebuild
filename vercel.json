{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://insight-api-tswg.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://insight-api-tswg.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://insight-api-tswg.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
